  def foldRight[A, B] (l: List[A], z: B, f: (A, B) =&gt; B): B = l match
    case Nil => z
    case Cons(a, as) => f(a, foldRight(as, z, f))

  def map[A, B] (l: List[A], f: A =&gt; B): List[B] =
    foldRight[A, List[B]] (l, Nil, (a, z) =&gt; Cons(f(a), z))</pre>
