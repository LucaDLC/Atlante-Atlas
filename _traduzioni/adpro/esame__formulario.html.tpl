    forAll { (a1: A, a2: A) => f(ma.combine(a1, a2)) === mb.combine(f(a1), f(a2)) } :| "combine" &amp;&amp;
    (f(ma.empty) === mb.empty) :| "empty"

  def isomorphism[B: Arbitrary](f: A => B, g: B => A)(mb: Monoid[B]): Prop =
    ma.homomorphism(f)(mb) &amp;&amp; mb.homomorphism(g)(ma) &amp;&amp;
    forAll { (a: A) => g(f(a)) === a } &amp;&amp; forAll { (b: B) => f(g(b)) === b }

// usi nei test
stringMonoid.isomorphism[List[Char]](_.toList, _.mkString)(listMonoid[Char])
booleanOr.isomorphism[Boolean](!_, !_)(booleanAnd)</pre>
