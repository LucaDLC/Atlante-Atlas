  <h4>{{s|s870|}}</h4>
<pre class="cod" data-lang="scala">trait Monad[F[_]]
  extends Functor[F]:

  def unit[A](a: => A): F[A]

  extension [A](fa: F[A])
    def flatMap[B] (f: A => F[B]): F[B]

    def map[B](f: A => B): F[B] =
      fa.flatMap[B] { a => unit(f(a)) }

    def map2[B, C](fb: F[B])(f: (A, B) => C): F[C] =
      fa.flatMap { a => fb.map { b => f(a,b) } }

lazy val optionMonad: Monad[Option] = new Monad[Option]:
  def unit[A](a: => A) = Some(a)
  extension [A](oa: Option[A])
    def flatMap[B](f: A => Option[B]): Option[B] = oa match
      case None => None
      case Some(a) => f(a)

lazy val listMonad: Monad[List] = new Monad[List]:
  def unit[A](a: => A) = List(a)
  extension [A](la: List[A])
    def flatMap[B](f: A => List[B]): List[B] = la.flatMap(f)</pre>
  <p>{{s|s871|}}</p>

  <h4>{{s|s872|}}</h4>
<pre class="cod" data-lang="scala">def associative[A, B, C](using ...): Prop =
  forAll { (x: F[A], f: A => F[B], g: B => F[C]) =>
    val left = x.flatMap[B](f).flatMap[C](g)
    val right = x.flatMap[C] { a => f(a).flatMap[C](g) }
    (left === right) :| s"left:$left right:$right" }

def identityRight[A](using ...) =
  forAll { (x: F[A], f: A => F[A]) =>
    val result = x.flatMap[A](unit[A])
    (result === x) :| s"got:$result expected:$x" }

def identityLeft[A: Arbitrary](using ...) =
  forAll { (y: A, f: A => F[A]) =>
    val left = unit[A](y).flatMap[A](f)
    val right = f(y)
    (left === right) :| s"left:$left right:$right" }</pre>
  <p>{{s|s873|}}</p>

  <h4>{{s|s874|}}</h4>
<pre class="cod" data-lang="scala">extension [F[_]](m: Monad[F])
  def sequence[A](fas: List[F[A]]): F[List[A]] =
    import m.*
    fas match
      case Nil => m.unit(Nil)
      case fa :: rest => fa.flatMap { a => m.sequence(rest).map { as => a :: as } }

  def replicateM[A](n: Int, ma: F[A]): F[List[A]] =
    m.sequence(List.fill(n)(ma))

  def compose[A, B, C](f: A => F[B], g: B => F[C]): A => F[C] =
    import m.*
    a => f(a).flatMap(g)</pre>
