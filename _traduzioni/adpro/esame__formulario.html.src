@@s132 <code>val</code>
@@s133 dà un nome a un valore, <b>per sempre</b> (non si riassegna)
@@s134 <code>val x = 3</code>
@@s135 <code>var</code>
@@s136 nome <b>riassegnabile</b>: <span class="t-no">vietato</span> negli esercizi
@@s137 <code>var i = 0</code>
@@s138 <code>def</code>
@@s139 definisce una funzione, eseguita a ogni chiamata
@@s140 <code>def f(x: Int): Int = x + 1</code>
@@s141 <code>lazy val</code>
@@s142 come <code>val</code> ma calcolato <b>al primo uso</b>, una volta sola
@@s143 <code>lazy val naturals = from(1)</code>
@@s144 <code>type</code>
@@s145 un altro nome per un tipo
@@s146 <code>type Rand[+A] = RNG =&gt; (A, RNG)</code>
@@s147 <code>opaque type</code>
@@s148 nome nuovo per un tipo, valido <b>solo dentro il file</b>: fuori nessuno sa cos'è
@@s149 <code>opaque type Gen[+A] = State[RNG, A]</code>
@@s150 <code>enum</code> / <code>case</code>
@@s151 tipo somma: elenca i casi possibili. Un <code>case</code> con campi è un prodotto
